{
  // Cloudflare Workers deploy: static assets from dist/, with a small Worker in front
  // that makes the site link-only (see worker/index.js). Needs a secret ACCESS_KEY.
  "name": "src-ai-course",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
